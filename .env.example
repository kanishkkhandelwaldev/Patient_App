# Copy to  .env  (project root) and fill in from Supabase → Project Settings → API.
# Restart the Expo dev server after editing (env is inlined at build time).
# With these unset, the app runs fully local/offline exactly as before.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
